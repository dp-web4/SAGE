{
  "fleet_version": 3,
  "description": "SAGE fleet manifest \u2014 static registry of all machines. Identity is anchored to lct_id (immutable). IPs are last-known and may be stale \u2014 use mDNS for discovery. | 2026-09-13: gateway_port corrected 8750 -> 8760 fleet-wide (the June Python->Rust cutover moved the port and this file was not updated, so peer_ask hit a dead port everywhere). gateway_host corrected for thor/sprout/cbp from mDNS + live /health; legion/mcnugget/nomad/hub unverifiable from thor and left as-is. NOTE: discovery.method is 'mdns' but fleet_registry.get_gateway_url() implements none of the discovery block \u2014 it reads the static IP only.",
  "discovery": {
    "method": "mdns",
    "fallback_order": [
      "mdns",
      "last_seen_ip",
      "static_ip"
    ],
    "mdns_timeout_ms": 500,
    "ip_cache_ttl_seconds": 3600,
    "gossip_enabled": true
  },
  "identity_tiers": {
    "immutable": [
      "lct_id",
      "hardware_ek"
    ],
    "characteristic": [
      "hostname",
      "mdns_name",
      "mac_address"
    ],
    "dynamic": [
      "gateway_host",
      "last_seen_ip",
      "last_seen_at",
      "model_default"
    ]
  },
  "resource_pools": {
    "synthesis": {
      "machines": [
        "thor",
        "sprout",
        "legion",
        "mcnugget"
      ],
      "account": 1,
      "role": "generative \u2014 code, implementations, large agent tasks",
      "weekly_reset": "thursday_21:00_local",
      "session_reset_hours": 5,
      "relative_budget": "large"
    },
    "oversight": {
      "machines": [
        "cbp",
        "nomad"
      ],
      "account": 2,
      "role": "review, planning, documentation, coordination, unblocking",
      "weekly_reset": null,
      "session_reset_hours": 5,
      "relative_budget": "baseline"
    }
  },
