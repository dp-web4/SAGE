<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS successor for a being's heartbeat: starts the next beat as soon as the running one
  ends, the job the systemd seats give a transient unit ordered After= the beat unit.

  sage.gateway.arousal arm_next drops one file named for the heartbeat label into the queue
  folder below. launchd starts this agent while that folder is not empty (QueueDirectories). The
  script waits for the running beat to end, empties the queue and kickstarts the beat.

  Install beside the heartbeat agent, replacing MACHINE, USER and the SAGE checkout path:
    label   com.web4.sage-heartbeat-next.MACHINE, which is the heartbeat label with
            sage-heartbeat changed to sage-heartbeat-next; arousal derives it the same way
    queue   ~/.local/state/sage/next-beat, the default of SAGE_NEXT_BEAT_QUEUE. Create it first:
            launchd does not create a QueueDirectories folder.
  Then load it with launchctl bootstrap gui/UID on the installed path.

  arousal reports a successor as armed only while this agent is loaded. Without it, an event
  that arrives during a beat stays pending until the next event or the heartbeat timer.
  No double hyphens in this comment: hestia's agent inventory parses plists with plistlib.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.web4.sage-heartbeat-next.MACHINE</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/USER/repos/SAGE/sage/scripts/launchd_next_beat.sh</string>
    <string>com.web4.sage-heartbeat.MACHINE</string>
    <string>/Users/USER/.local/state/sage/next-beat</string>
  </array>
  <key>QueueDirectories</key>
  <array>
    <string>/Users/USER/.local/state/sage/next-beat</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/sage/next-beat.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/sage/next-beat.log</string>
</dict>
</plist>
