################################################################################
# SAGE Daemon (Rust) — Sprout (Jetson Orin Nano, Qwen 3.5 0.8B via Ollama)
#
# Replaces the Python sage.gateway daemon. Consciousness loop, SNARC,
# metabolic state, federation, dashboard — all in ~12MB RSS.
#
# INSTALLATION:
#   sudo cp sage-daemon.service /etc/systemd/system/sage-daemon-sprout.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable sage-daemon-sprout
#   sudo systemctl start sage-daemon-sprout
#
# MONITORING:
#   journalctl -u sage-daemon-sprout -f
#   curl http://localhost:8760/health
#   http://localhost:8760/          (dashboard)
################################################################################

[Unit]
Description=SAGE Consciousness Daemon (Sprout — Rust)
After=ollama.service
After=network.target

[Service]
ExecStartPre=/bin/sleep 5
Type=simple
User=sprout
WorkingDirectory=/home/sprout/ai-workspace/SAGE
ExecStart=/home/sprout/ai-workspace/SAGE/sage-rs/target/release/sage-daemon

Environment=SAGE_MODEL=qwen3.5:0.8b
Environment=SAGE_MACHINE=sprout
Environment=RUST_LOG=info

Restart=always
RestartSec=30

# Logs must survive (SAGE #111 finding 5). On a box with no user journal — Sprout, measured
# 2026-09-17 — `journal` discards everything: 45 h of output, including the peer monitor's own
# startup line and every hundredth-cycle report, existed nowhere, which is why a dashboard
# reading zeros could not be diagnosed from logs. Keep `journal` only where
# `journalctl --user -u sage-daemon` actually shows output.
StandardOutput=append:/home/dp/ai-workspace/sage/sage-rs/daemon.log
StandardError=append:/home/dp/ai-workspace/sage/sage-rs/daemon.log
SyslogIdentifier=sage-daemon-sprout

MemoryMax=512M
LimitNOFILE=65536
TimeoutStartSec=30
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
